# ─────────────── barcode_gen (NestJS) ───────────────
NODE_ENV=development
PORT=8080

DATABASE_URL=postgresql://billing:billing@postgres:5432/barcodegen_db

# Должен совпадать с BFF JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=change-me
# Billing-stub BFF (внутренний)
BILLING_URL=http://bff:8080/internal/v1/billing

KAFKA_ENABLED=true
KAFKA_CLIENT_ID=barcodegen
KAFKA_BROKERS=kafka:9092

# Общий секрет BFF <-> barcode_gen для /api/internal/v1/*
BARCODEGEN_SERVICE_TOKEN=change-me

# CORS (CSV)
ALLOWED_ORIGINS=http://localhost:3000

# ─────────────── render-сервис (Python) ───────────────
RENDER_URL=http://render:8000
RENDER_TIMEOUT=30000
RENDER_MAX_CONCURRENCY=4
RENDER_QUEUE_SIZE=0

# Object storage (MinIO/S3) для render. Пусто = локальный режим (dev).
STORAGE_ENDPOINT=
STORAGE_BUCKET=barcodes
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=
# Публичный URL render в локальном режиме (без MinIO)
RENDER_PUBLIC_URL=http://localhost:18000/files
